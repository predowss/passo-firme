# Modelo do .env local. Não preencha à mão: rode ./scripts/gerar-env-local.sh,
# que gera valores aleatórios. O .env real está no .gitignore e nunca vai para o Git.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Vazio = /metrics aberto (só no ambiente local).
METRICS_TOKEN=
OPS_TOKEN=
AUTOR_SALT=
CORS_ORIGINS=http://localhost:5173
